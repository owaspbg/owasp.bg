---
import '../styles/global.css';
import Sprite from '../components/Sprite.astro';
import Footer from '../components/Footer.astro';
import { SITE, abs } from '../lib/site';
import { organization, website } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD nodes for this page; Organization and WebSite are always included. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description = SITE.description, image = SITE.image, imageAlt, type = 'website', schema = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} | OWASP Sofia` : 'OWASP Sofia — OWASP общността в България';
const path = Astro.url.pathname;
const canonical = abs(path);
const ogImage = abs(image);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [organization(), website(), ...schema] }).replace(/</g, '\\u003c');
const nav = [
  ['/events/', 'icon-calendar', 'Събития'],
  ['/resources/', 'icon-book', 'Ресурси'],
  ['/resources/#top10', 'icon-shield', 'Top 10'],
  ['/about/', 'icon-users', 'За нас'],
  ['/contact/', 'icon-mail', 'Контакти'],
];
---
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    {noindex ? <meta name="robots" content="noindex, follow"> : <link rel="canonical" href={canonical}>}
    <meta name="theme-color" content="#10002f">
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="OWASP Sofia">
    <meta property="og:locale" content="bg_BG">
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:alt" content={imageAlt ?? fullTitle}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline defer src="https://umami.miglen.com/script.js" data-website-id="82faab38-3cc8-4d91-af9a-f6213b3c3287"></script>
</head>
<body>
<Sprite />
<header class="nav">
    <a href="/" class="brand"><img src="/assets/images/owasp-logo.svg" alt="OWASP Sofia — начало"></a>
    <button class="nav-toggle" aria-label="Меню" aria-expanded="false" onclick="this.setAttribute('aria-expanded', document.querySelector('nav.primary').classList.toggle('open'))">
        <span></span><span></span><span></span>
    </button>
    <nav class="primary">
        {nav.map(([href, icon, label]) => (
            <a href={href} aria-current={path.startsWith(href) && !href.includes('#') ? 'page' : undefined}><svg><use href={`#${icon}`}/></svg>{label}</a>
        ))}
    </nav>
</header>
<main>
    <slot />
</main>
<Footer />
</body>
</html>
