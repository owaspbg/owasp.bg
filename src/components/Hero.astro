---
import { Image } from 'astro:assets';
import { formatDate, eventUrl, type Event } from '../lib/events';
import { SITE } from '../lib/site';

interface Props { events: Event[] }
const { events } = Astro.props;
const featured = events[0];
const talks = events.reduce((n, e) => n + e.data.sessions.length, 0);
const speakers = new Set(events.flatMap((e) => e.data.sessions.map((s) => s.speaker))).size;
const firstYear = Math.min(...events.map((e) => e.data.date.getUTCFullYear()));
const years = new Date().getFullYear() - firstYear;
const upcoming = featured.data.date.getTime() + 86_400_000 > Date.now();
const venue = featured.data.location?.split(',')[0];
---
<section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-copy">
        <p class="hero-badge"><span class="hero-dot"></span>Чаптър на OWASP Foundation в София</p>
        <h1>OWASP <span>Sofia</span></h1>
        <p class="lead">
            Общността за сигурност на софтуера в България. Безплатни срещи
            с практични технически презентации — от практици, за практици.
        </p>
        <div class="hero-buttons">
            <a href={`${SITE.links.meetup}events/?type=upcoming`} target="_blank" rel="noopener" class="btn btn-primary">
                <svg><use href="#icon-calendar"/></svg>Следваща среща
            </a>
            <a href="/events/" class="btn btn-ghost"><svg><use href="#icon-archive"/></svg>Всички срещи</a>
            <a href="https://forms.gle/1XCeTUD3yrdQehu56" target="_blank" rel="noopener" class="hero-link">
                <svg><use href="#icon-mic"/></svg>Изнеси презентация →
            </a>
        </div>
        <dl class="hero-stats">
            <div class="hero-stat"><dt>Срещи</dt><dd>{events.length}</dd></div>
            <div class="hero-stat"><dt>Презентации</dt><dd>{talks}</dd></div>
            <div class="hero-stat"><dt>Лектори</dt><dd>{speakers}</dd></div>
            <div class="hero-stat"><dt>Години</dt><dd>{years}</dd></div>
        </dl>
    </div>

    <a href={eventUrl(featured)} class="hero-event" data-date={featured.id}>
        {featured.cover && (
            <Image src={featured.cover} alt={`Банер на ${featured.title}`} width={720} quality={80} loading="eager" fetchpriority="high" class="hero-event-cover" />
        )}
        <div class="hero-event-body">
            <p class="hero-event-label">
                <span class="hero-event-when">{upcoming ? 'Следваща среща' : 'Последна среща'}</span>
                <time datetime={featured.id}>{formatDate(featured.data.date)}</time>
            </p>
            {venue && <p class="hero-event-venue"><svg class="icon-svg-sm"><use href="#icon-pin"/></svg>{venue}</p>}
            <ul class="hero-event-talks">
                {featured.data.sessions.slice(0, 3).map((s) => (
                    <li><strong>{s.title}</strong><span>{s.speaker}{s.company && ` · ${s.company}`}</span></li>
                ))}
            </ul>
            <span class="hero-event-cta">Програма и материали <svg class="icon-svg-sm"><use href="#icon-arrow"/></svg></span>
        </div>
    </a>
</section>

<script is:inline>
    // The page is static: flip "Следваща" to "Последна" once the featured meetup has passed.
    document.querySelectorAll('.hero-event[data-date]').forEach(function (card) {
        if (new Date(card.dataset.date + 'T23:59:59') < new Date()) card.querySelector('.hero-event-when').textContent = 'Последна среща';
    });
</script>
