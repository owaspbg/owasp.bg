---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Leaders from '../components/Leaders.astro';
import Partners from '../components/Partners.astro';
import Faq from '../components/Faq.astro';
import { faqSchema } from '../lib/faq';
import { breadcrumbs } from '../lib/schema';
---
<Base title="За нас" description="Какво е OWASP Sofia: мисия, лидери на чаптъра, приятелски организации и отговори на честите въпроси — как да участваш, да изнесеш презентация или да станеш домакин." schema={[faqSchema(), breadcrumbs([['Начало', '/'], ['За нас', '/about/']])]}>
    <About />
    <Leaders />
    <Faq />
    <Partners />
</Base>
