---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Leaders from '../components/Leaders.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents } from '../lib/events';

const events = await getEvents();
const latest = events.slice(1, 4); // the newest one is featured in the hero
---
<Base>
    <Hero events={events} />
    <section>
        <div class="container">
            <div class="section-head section-head-row">
                <div>
                    <p class="eyebrow">Събития</p>
                    <h2 class="section-title">Предишни срещи</h2>
                </div>
                <a href="/events/" class="btn btn-ghost">Всички събития →</a>
            </div>
            <div class="events-grid">{latest.map((e) => <EventCard event={e} />)}</div>
        </div>
    </section>
    <About />
    <Leaders />
</Base>
