---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getEvents, formatDate, eventUrl, program, type Event } from '../lib/events';
import { embedUrl, fileUrl, isPdf } from '../lib/media';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event, i) => ({
    params: { slug: event.slug },
    props: { event, newer: events[i - 1], older: events[i + 1] },
  }));
}

interface Props { event: Event; newer?: Event; older?: Event }
const { event, newer, older } = Astro.props;
const { date, location, locationUrl, hosts, meetup, recording, sessions } = event.data;
const { Content } = await render(event);
const recordingEmbed = recording && embedUrl(recording);
const photos = await Promise.all(event.gallery.map(async (img) => ({ img, full: (await getImage({ src: img, width: 1920, quality: 80 })).src })));
const cover = event.cover && (await getImage({ src: event.cover, width: 1200 })).src;
const items = program(event);
const timed = items.some((p) => p.time);
const times = items.map((p) => p.time).filter(Boolean);
const hours = times.length > 1 ? `${times[0]} – ${times.at(-1)} ч.` : times[0] && `${times[0]} ч.`;
---
<Base title={event.title} description={`${formatDate(date)} · ${sessions.map((s) => s.title).join(' · ')}`} image={cover}>
    <section class="page-hero">
        <div class="container event-hero">
          <div>
            <div class="breadcrumb"><a href="/events/">Събития</a> &nbsp;/&nbsp; {formatDate(date)}</div>
            <h1>{event.title}</h1>
            <ul class="event-meta">
                <li><svg class="icon-svg-sm"><use href="#icon-calendar"/></svg><span><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>{hours && <>, {hours}</>}</span></li>
                {location && <li><svg class="icon-svg-sm"><use href="#icon-pin"/></svg><span>{locationUrl ? <a href={locationUrl} target="_blank" rel="noopener">{location}</a> : location}</span></li>}
                {hosts.length > 0 && (
                    <li><svg class="icon-svg-sm"><use href="#icon-building"/></svg><span>{hosts.length > 1 ? 'Домакини' : 'Домакин'}:{' '}
                        {hosts.map((h, i) => <>{i > 0 && ' и '}{h.url ? <a href={h.url} target="_blank" rel="noopener">{h.name}</a> : h.name}</>)}</span>
                    </li>
                )}
            </ul>
            <nav class="event-jump">
                <a href="#program" class="btn btn-ghost">Програма</a>
                {recording && <a href="#recording" class="btn btn-ghost"><svg><use href="#icon-play"/></svg>Запис</a>}
                {photos.length > 0 && <a href="#gallery" class="btn btn-ghost"><svg><use href="#icon-image"/></svg>Снимки ({photos.length})</a>}
                {meetup && <a href={meetup} target="_blank" rel="noopener" class="btn btn-primary">Meetup →</a>}
            </nav>
          </div>
          {event.cover && <Image src={event.cover} alt={`Банер на ${event.title}`} width={720} quality={80} class="event-hero-cover" loading="eager" />}
        </div>
    </section>

    <div class="container event-page">
        <div class="event-description"><Content /></div>

        {recording && (
            <section id="recording" class="event-section">
                <h2 class="section-title">Запис</h2>
                {recordingEmbed
                    ? <div class="video-embed"><iframe src={recordingEmbed} title={`Запис: ${event.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
                    : <a href={recording} target="_blank" rel="noopener" class="btn btn-primary">Гледай записа →</a>}
            </section>
        )}

        <section id="program" class="event-section">
            <h2 class="section-title">Програма</h2>
            <ol class:list={['sessions', { timed }]}>
                {items.map((s) => {
                    const who = s.speaker && (
                        <>
                            {s.speakerUrl
                                ? <a href={s.speakerUrl} target="_blank" rel="noopener" class="author-link">{s.speaker} <svg class="icon-svg-sm"><use href={s.speakerUrl.includes('x.com') ? '#icon-x' : s.speakerUrl.includes('linkedin.com') ? '#icon-linkedin' : '#icon-web'}/></svg></a>
                                : s.speaker}
                            {s.company && <> <span class="session-at">@</span> {s.companyUrl ? <a href={s.companyUrl} target="_blank" rel="noopener" class="company-link">{s.company}</a> : s.company}</>}
                        </>
                    );
                    if (s.kind === 'slot') return (
                        <li class="slot">
                            <time class="session-time">{s.time}</time>
                            <p><strong>{s.title}</strong>{who && <span class="slot-who"> — {who}</span>}</p>
                        </li>
                    );
                    const videoEmbed = s.video && embedUrl(s.video);
                    return (
                        <li class="session glass-card">
                            {s.time ? <time class="session-time">{s.time}</time> : <span class="session-num">{String(s.n).padStart(2, '0')}</span>}
                            <div class="session-body">
                                <h3>{s.title}</h3>
                                <p class="session-speaker">{who}</p>
                                {s.abstract && <p class="session-abstract">{s.abstract}</p>}
                                <div class="session-actions">
                                    {s.slides && isPdf(s.slides) && <>
                                        <button type="button" class="btn btn-ghost" data-embed={fileUrl(s.slides)} data-title={s.title} data-kind="pdf"><svg><use href="#icon-eye"/></svg>Разгледай слайдовете</button>
                                        <a href={fileUrl(s.slides)} download class="btn btn-ghost"><svg><use href="#icon-download"/></svg>Изтегли PDF</a>
                                    </>}
                                    {s.slides && !isPdf(s.slides) && <a href={fileUrl(s.slides)} target="_blank" rel="noopener" class="btn btn-ghost"><svg><use href="#icon-eye"/></svg>Слайдове ↗</a>}
                                    {s.video && (videoEmbed
                                        ? <button type="button" class="btn btn-ghost" data-embed={videoEmbed} data-title={s.title} data-kind="video"><svg><use href="#icon-play"/></svg>Гледай</button>
                                        : <a href={s.video} target="_blank" rel="noopener" class="btn btn-ghost"><svg><use href="#icon-play"/></svg>Видео ↗</a>)}
                                </div>
                            </div>
                        </li>
                    );
                })}
            </ol>
        </section>

        {photos.length > 0 && (
            <section id="gallery" class="event-section">
                <h2 class="section-title">Снимки</h2>
                <div class="gallery">
                    {photos.map(({ img, full }, i) => (
                        <a href={full} class="gallery-item" data-index={i}>
                            <Image src={img} alt={`Снимка ${i + 1} от ${event.title}`} width={480} height={360} fit="cover" quality={70} />
                        </a>
                    ))}
                </div>
            </section>
        )}

        <nav class="event-pager">
            {older ? <a href={eventUrl(older)} class="glass-card"><small>← По-стара среща</small>{older.title}</a> : <span />}
            {newer ? <a href={eventUrl(newer)} class="glass-card"><small>По-нова среща →</small>{newer.title}</a> : <span />}
        </nav>
    </div>

    <dialog id="viewer" class="viewer">
        <div class="viewer-bar">
            <strong class="viewer-title"></strong>
            <a class="viewer-open" target="_blank" rel="noopener">Отвори в нов таб ↗</a>
            <button type="button" class="viewer-close" aria-label="Затвори"><svg class="icon-svg"><use href="#icon-close"/></svg></button>
        </div>
        <iframe title="Преглед" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen hidden></iframe>
        <div class="pdf-pages" hidden><p class="pdf-status">Зареждане…</p></div>
    </dialog>

    <dialog id="lightbox" class="lightbox" aria-label="Галерия">
        <button type="button" class="lb-close" aria-label="Затвори"><svg class="icon-svg"><use href="#icon-close"/></svg></button>
        <button type="button" class="lb-prev" aria-label="Предишна"><svg class="icon-svg"><use href="#icon-left"/></svg></button>
        <img alt="" />
        <button type="button" class="lb-next" aria-label="Следваща"><svg class="icon-svg"><use href="#icon-right"/></svg></button>
        <span class="lb-count"></span>
    </dialog>
</Base>

<script>
    // Slides (pdf.js renders on every device, unlike a PDF in an iframe) / video viewer
    const viewer = document.querySelector<HTMLDialogElement>('#viewer')!;
    const frame = viewer.querySelector('iframe')!;
    const pages = viewer.querySelector<HTMLDivElement>('.pdf-pages')!;
    let session = 0;
    async function renderPdf(url: string, id: number) {
        pages.innerHTML = '<p class="pdf-status">Зареждане…</p>';
        try {
            const pdfjs = await import('pdfjs-dist');
            pdfjs.GlobalWorkerOptions.workerSrc = (await import('pdfjs-dist/build/pdf.worker.min.mjs?url')).default;
            const task = pdfjs.getDocument({ url: new URL(url, location.href).href });
            const doc = await task.promise;
            pages.innerHTML = '';
            for (let n = 1; n <= doc.numPages && id === session; n++) {
                const page = await doc.getPage(n);
                if (id !== session) break; // viewer was closed or switched meanwhile
                const scale = (pages.clientWidth / page.getViewport({ scale: 1 }).width) * Math.min(devicePixelRatio, 2);
                const viewport = page.getViewport({ scale });
                const canvas = document.createElement('canvas');
                canvas.width = viewport.width;
                canvas.height = viewport.height;
                canvas.setAttribute('aria-label', `Слайд ${n} от ${doc.numPages}`);
                pages.append(canvas);
                await page.render({ canvas, viewport }).promise;
            }
            task.destroy();
        } catch (err) {
            console.error(err);
            if (id === session) pages.innerHTML = '<p class="pdf-status">Презентацията не може да се покаже тук. Използвай „Отвори в нов таб“ или „Изтегли PDF“.</p>';
        }
    }
    document.querySelectorAll<HTMLButtonElement>('[data-embed]').forEach((btn) =>
        btn.addEventListener('click', () => {
            const url = btn.dataset.embed!;
            const isPdf = btn.dataset.kind === 'pdf';
            viewer.classList.toggle('is-video', !isPdf);
            frame.hidden = isPdf;
            pages.hidden = !isPdf;
            viewer.querySelector('.viewer-title')!.textContent = btn.dataset.title ?? '';
            viewer.querySelector<HTMLAnchorElement>('.viewer-open')!.href = url;
            viewer.showModal();
            if (isPdf) renderPdf(url, ++session);
            else frame.src = url;
        }));
    viewer.querySelector('.viewer-close')!.addEventListener('click', () => viewer.close());
    viewer.addEventListener('close', () => { frame.src = 'about:blank'; session++; pages.innerHTML = ''; }); // stops playback / rendering
    viewer.addEventListener('click', (e) => { if (e.target === viewer) viewer.close(); });

    // Photo lightbox (links still work without JS)
    const items = [...document.querySelectorAll<HTMLAnchorElement>('.gallery-item')];
    const lb = document.querySelector<HTMLDialogElement>('#lightbox')!;
    const img = lb.querySelector('img')!;
    let current = 0;
    const show = (i: number) => {
        current = (i + items.length) % items.length;
        img.src = items[current].href;
        img.alt = items[current].querySelector('img')!.alt;
        lb.querySelector('.lb-count')!.textContent = `${current + 1} / ${items.length}`;
    };
    items.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); show(i); lb.showModal(); }));
    lb.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
    lb.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
    lb.querySelector('.lb-close')!.addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
    });
    let touchX = 0;
    lb.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
</script>
